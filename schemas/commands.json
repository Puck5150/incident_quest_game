{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "minItems": 1,
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "match": {
        "type": "string",
        "minLength": 1
      },
      "summary": {
        "type": "string",
        "minLength": 1
      },
      "parts": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "token": {
              "type": "string",
              "minLength": 1
            },
            "meaning": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "token",
            "meaning"
          ],
          "additionalProperties": false
        }
      },
      "why": {
        "type": "string",
        "minLength": 1
      },
      "alternatives": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "command",
            "note"
          ],
          "additionalProperties": false
        }
      },
      "docs": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "match",
      "summary",
      "parts",
      "why",
      "alternatives",
      "docs"
    ],
    "additionalProperties": false
  }
}

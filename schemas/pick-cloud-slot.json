{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "const": "challenge"
    },
    "providers": {
      "minItems": 2,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "aws",
          "azure",
          "gcp"
        ]
      }
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "track": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "published": {
      "type": "boolean"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "par_minutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "brief": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "budget": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "labels": {
      "default": {},
      "type": "object",
      "properties": {
        "aws": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "azure": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "gcp": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "tiers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "options": {
            "minItems": 2,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                },
                "cost": {
                  "type": "number",
                  "minimum": 0
                },
                "capabilities": {
                  "default": {
                    "survives": [],
                    "scales": 1
                  },
                  "type": "object",
                  "properties": {
                    "survives": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
                      }
                    },
                    "scales": {
                      "default": 1,
                      "type": "number",
                      "minimum": 0
                    },
                    "rpo": {
                      "type": "string",
                      "enum": [
                        "zero",
                        "seconds",
                        "minutes",
                        "hours"
                      ]
                    }
                  },
                  "additionalProperties": false
                },
                "overkill": {
                  "type": "string"
                },
                "as": {
                  "type": "object",
                  "properties": {
                    "aws": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "short": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 22
                        },
                        "facts": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "label",
                        "facts"
                      ],
                      "additionalProperties": false
                    },
                    "azure": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "short": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 22
                        },
                        "facts": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "label",
                        "facts"
                      ],
                      "additionalProperties": false
                    },
                    "gcp": {
                      "type": "object",
                      "properties": {
                        "label": {
                          "type": "string",
                          "minLength": 1
                        },
                        "short": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 22
                        },
                        "facts": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "label",
                        "facts"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                },
                "differences": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "cost",
                "as",
                "differences"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label",
          "options"
        ],
        "additionalProperties": false
      }
    },
    "stress_tests": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "requires": {}
        },
        "required": [
          "id",
          "label",
          "requires"
        ],
        "additionalProperties": false
      }
    },
    "failure_feedback": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reference_designs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "picks": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
            }
          },
          "why": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "picks",
          "why"
        ],
        "additionalProperties": false
      }
    },
    "hints": {
      "type": "object",
      "properties": {
        "nudge": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "nudge",
        "direction",
        "answer"
      ],
      "additionalProperties": false
    },
    "analogy": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "title",
        "text"
      ],
      "additionalProperties": false
    },
    "debrief": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "real_world": {
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "properties": {
        "aws": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "retrieved": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              }
            },
            "required": [
              "title",
              "url",
              "retrieved"
            ],
            "additionalProperties": false
          }
        },
        "azure": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "retrieved": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              }
            },
            "required": [
              "title",
              "url",
              "retrieved"
            ],
            "additionalProperties": false
          }
        },
        "gcp": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "retrieved": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              }
            },
            "required": [
              "title",
              "url",
              "retrieved"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "type",
    "providers",
    "id",
    "track",
    "difficulty",
    "title",
    "par_minutes",
    "brief",
    "requirements",
    "budget",
    "tiers",
    "stress_tests",
    "reference_designs",
    "hints",
    "analogy",
    "debrief",
    "sources"
  ],
  "additionalProperties": false
}
